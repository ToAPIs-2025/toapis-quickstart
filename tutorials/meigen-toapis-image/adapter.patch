+/** Minimal ToAPIs text-to-image adapter. No MeiGen Cloud requests or credits. */
+import { abortableDelay, withHttpResponse, boundedJson, boundedBytes, responseError } from '../generation-http.js'
+import type { ImageGenerationRequest, ImageGenerationResult } from './types.js'
+
+export function isToAPIsBase(base: string): boolean {
+  try { const url = new URL(base); return url.protocol === 'https:' && ['toapis.com', 'toapis.cn'].includes(url.hostname) } catch { return false }
+}
+
+export async function generateToAPIs(key: string, base: string, model: string, request: ImageGenerationRequest): Promise<ImageGenerationResult> {
+  if (!isToAPIsBase(base)) throw new Error('Use the HTTPS ToAPIs origin or /v1 base URL.')
+  if (model !== 'gpt-image-2') throw new Error('This initial adapter supports gpt-image-2 only; other models need separate validation.')
+  if (request.referenceImages?.length) throw new Error('Reference images are not supported in this first text-to-image adapter.')
+  if (request.n && request.n !== 1) throw new Error('This adapter generates one image per call.')
+  const origin = new URL(base)
+  if (!['/', '/v1', '/v1/'].includes(origin.pathname) || origin.search || origin.hash || origin.username || origin.password) throw new Error('Base URL must be the ToAPIs origin or /v1.')
+  const endpoint = `${origin.origin}/v1/images/generations`
+  const ratios: Record<string, string> = { '1024x1024': '1:1', '1536x1024': '3:2', '1024x1536': '2:3', auto: '1:1' }
+  const size = request.aspectRatio || ratios[request.size || '1024x1024'] || request.size
+  if (!size || !/^\d+:\d+$/.test(size)) throw new Error('Use aspectRatio such as 1:1 or 16:9, or a supported pixel size.')
+  const resolution = (request.resolution || '1k').toLowerCase()
+  if (!['1k', '2k', '4k'].includes(resolution)) throw new Error('Resolution must be 1K, 2K, or 4K.')
+  const body = { model, prompt: request.prompt, size, resolution, n: 1, response_format: 'url' }
+  const headers = { Authorization: `Bearer ${key}`, 'Content-Type': 'application/json' }
+  // Never retry a POST: a network timeout may happen after the task was accepted.
+  const submitted = await withHttpResponse(endpoint, { method: 'POST', headers, body: JSON.stringify(body), redirect: 'error' }, 60_000, async (response, signal) => {
+    const json = await boundedJson(response, undefined, signal)
+    if (!response.ok) throw responseError(response, json)
+    return json
+  }, request.signal)
+  const id = submitted.id || submitted.task_id
+  if (typeof id !== 'string' || !id) throw new Error('No task ID returned. Check ToAPIs tasks before submitting again.')
+  console.error('TOAPIS_TASK ' + JSON.stringify({ taskId: id, model, status: 'submitted', request: body }))
+  const deadline = Date.now() + 600_000
+  try {
+    while (Date.now() < deadline) {
+      const observation = await withHttpResponse(`${endpoint}/${encodeURIComponent(id)}`, { headers, redirect: 'error' }, Math.min(30_000, deadline - Date.now()), async (response, signal) => {
+        const json = await boundedJson(response, undefined, signal)
+        if ([429, 503].includes(response.status)) {
+          const raw = response.headers.get('retry-after')
+          const delay = raw ? (/^\d+$/.test(raw) ? Number(raw) * 1000 : Date.parse(raw) - Date.now()) : 8000
+          return { retryMs: Number.isFinite(delay) ? Math.max(8000, delay) : 8000, json: undefined }
+        }
+        if (!response.ok) throw responseError(response, json)
+        return { retryMs: 0, json }
+      }, request.signal)
+      if (observation.retryMs) { await abortableDelay(Math.min(observation.retryMs, Math.max(0, deadline - Date.now())), request.signal); continue }
+      const task = observation.json!
+      if (task.status === 'completed') {
+        const result = task.result as { data?: Array<{ url?: string }> } | undefined
+        const url = result?.data?.[0]?.url
+        if (!url || new URL(url).protocol !== 'https:') throw new Error('Completed task has no HTTPS image result.')
+        console.error('TOAPIS_TASK ' + JSON.stringify({ taskId: id, model, status: 'completed', usage: task.usage ?? null, cost: task.cost ?? null }))
+        if (request.download === false) return { imageBase64: '', mimeType: 'image/png', imageUrl: url }
+        // Asset download carries no API key.
+        return await withHttpResponse(url, { redirect: 'error' }, 60_000, async (response, signal) => {
+          if (!response.ok) throw new Error(`Image download failed (${response.status})`)
+          const mimeType = response.headers.get('content-type')?.split(';')[0] || ''
+          if (!mimeType.startsWith('image/')) throw new Error('Result is not an image.')
+          return { imageBase64: (await boundedBytes(response, 64 * 1024 * 1024, signal)).toString('base64'), mimeType, imageUrl: url }
+        }, request.signal)
+      }
+      if (['failed', 'cancelled', 'canceled', 'error'].includes(String(task.status))) throw new Error(`Generation ended with status ${task.status}`)
+      await abortableDelay(Math.min(8000, Math.max(0, deadline - Date.now())), request.signal)
+    }
+    throw new Error('Observation timed out; the task may still be running.')
+  } catch (error) {
+    throw new Error(`${error instanceof Error ? error.message : 'Task observation failed'} ToAPIs task ID: ${id}. Query this task before generating again.`)
+  }
+}
